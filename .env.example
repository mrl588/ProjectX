DATABASE_URL=postgresql://pm:pm@localhost:5432/pm_day
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-string
ALLOW_DEV_LOGIN=true
WEB_ORIGIN=http://localhost:5173
API_PORT=4000

# Google OAuth. Leave blank to use the dev login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Gemini. Leave blank and pasted messages use the subject-line fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
